<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse MSIX package.

  "Sparse" means the application installs like any normal program, into
  whichever folder you choose, and this package only supplies the identity
  Windows 11 demands before it will register a context menu entry. It is what
  NanaZip does, and it is the only route Windows 11 supports without writing
  to the registry.

  Two things have to be changed before using it:
    1. The CLSID in com:Class and in desktop5:ItemType must match, letter for
       letter, CLSID_ARCA in arca-shell/src/lib.rs.
    2. Publisher must match the subject of the certificate you sign with
       exactly. When they differ, the install fails with an error that does
       not say why.

  Keep this file ASCII. The installer stamps the version into it through
  Inno Setup's Pascal, whose string type goes through the ANSI code page, so
  any accented byte in here would come back out mangled. The CI checks it.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  IgnorableNamespaces="uap uap10 rescap com desktop4 desktop5">

  <!-- Version is stamped at install time from the real one. Left as zeros
       here so that a manifest nobody stamped is obviously wrong instead of
       quietly claiming to be some release from months ago: this said 0.3.0.0
       while 0.5.0 was shipping, and Windows believed it. -->
  <Identity
    Name="Arca.Archivador"
    Publisher="CN=CHANGEME"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Arca</DisplayName>
    <PublisherDisplayName>Arca Project</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Required for a sparse package: without it, Add-AppxPackage
         -ExternalLocation fails with 0x80073D2E, which is exactly what
         build.ps1 does. This is what authorises the .exe and the .dll to
         live outside the package, in the normal install folder. -->
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <!-- 10.0.22000.0 is Windows 11: IExplorerCommand in the modern menu
         needs at least that version. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="es-ES" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="Arca"
                 Executable="arca.exe"
                 uap10:TrustLevel="mediumIL"
                 uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="Arca"
        Description="Fast and safe archiver"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent"
        AppListEntry="none" />

      <Extensions>
        <!-- The Windows 11 context menu entry -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="Arca"
                             Clsid="E075AD96-F5BD-4BFF-8C33-A29D05352EFA" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="Arca"
                             Clsid="E075AD96-F5BD-4BFF-8C33-A29D05352EFA" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <!-- The COM server behind that entry -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Arca Shell">
              <com:Class Id="E075AD96-F5BD-4BFF-8C33-A29D05352EFA"
                         Path="arca_shell.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
